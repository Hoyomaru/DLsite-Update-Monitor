<UserControl x:Class="DLsiteUpdateMonitor.UpdateCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="更新センター" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="変更やエラーを確認し、そのまま処理できます。" Margin="0,4,0,10" Opacity="0.75"/>
            <TextBlock x:Name="StatusMessageText" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,10" Visibility="Collapsed"/>

            <UniformGrid Columns="5" Margin="0,0,0,12">
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="追跡中" Opacity="0.7"/>
                    <TextBlock x:Name="TrackedCountText" Text="0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="要対応" Opacity="0.7"/>
                    <TextBlock x:Name="AttentionCountText" Text="0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="更新情報" Opacity="0.7"/>
                    <TextBlock x:Name="UpdateCountText" Text="0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="配布物変更" Opacity="0.7"/>
                    <TextBlock x:Name="FileCountText" Text="0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="エラー / 要確認" Opacity="0.7"/>
                    <TextBlock x:Name="ErrorCountText" Text="0" FontSize="22" FontWeight="Bold"/>
                </StackPanel>
            </UniformGrid>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="FilterComboBox" Grid.Column="0" SelectionChanged="FilterChanged">
                <ComboBoxItem Content="要対応" Tag="Attention"/>
                <ComboBoxItem Content="更新あり" Tag="Update"/>
                <ComboBoxItem Content="配布物変更" Tag="File"/>
                <ComboBoxItem Content="エラー / 要確認" Tag="Error"/>
                <ComboBoxItem Content="対応不要" Tag="Clean"/>
                <ComboBoxItem Content="すべて" Tag="All"/>
            </ComboBox>
            <TextBlock Grid.Column="2" Text="検索" VerticalAlignment="Center"/>
            <TextBox x:Name="SearchTextBox" Grid.Column="4" TextChanged="SearchChanged"
                     ToolTip="ゲーム名・作品ID・状態で検索"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ItemsGrid" Grid.Column="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionChanged="ItemsGrid_SelectionChanged"
                      MouseDoubleClick="ItemsGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="変更" Binding="{Binding ChangeText}" Width="130"/>
                    <DataGridTextColumn Header="ゲーム" Binding="{Binding GameName}" Width="*"/>
                    <DataGridTextColumn Header="確認状態" Binding="{Binding HealthText}" Width="150"/>
                    <DataGridTextColumn Header="最終チェック" Binding="{Binding LastCheckText}" Width="125"/>
                    <DataGridTextColumn Header="作品ID" Binding="{Binding ProductId}" Width="115"/>
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Column="2" Header="選択中の作品" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock x:Name="DetailEmptyText" Text="左の一覧からゲームを選択してください。" TextWrapping="Wrap" Opacity="0.7"/>

                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <TextBlock x:Name="DetailGameNameText" FontSize="17" FontWeight="Bold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailChangeText" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DetailHealthText" Margin="0,4,0,0" TextWrapping="Wrap"/>

                            <Separator Margin="0,12"/>

                            <TextBlock Text="作品ID" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailProductIdText" Margin="0,2,0,8" TextWrapping="Wrap"/>

                            <TextBlock Text="更新情報" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailUpdateInfoText" Margin="0,2,0,8" TextWrapping="Wrap"/>

                            <TextBlock Text="ファイル容量" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailFileSizeText" Margin="0,2,0,8" TextWrapping="Wrap"/>

                            <TextBlock Text="最終チェック" FontWeight="SemiBold"/>
                            <TextBlock x:Name="DetailLastCheckText" Margin="0,2,0,8" TextWrapping="Wrap"/>

                            <StackPanel x:Name="DetailErrorPanel" Visibility="Collapsed">
                                <TextBlock Text="要確認" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DetailErrorText" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button x:Name="RecheckButton" Content="選択を再確認" Padding="14,7" Margin="0,0,8,0"
                        Click="RecheckButton_Click" IsEnabled="False"/>
                <Button x:Name="AppliedButton" Content="適用済みにする" Padding="14,7" Margin="0,0,8,0"
                        Click="AppliedButton_Click" IsEnabled="False"/>
                <Button x:Name="IgnoreButton" Content="無視する" Padding="14,7"
                        Click="IgnoreButton_Click" IsEnabled="False"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="DetailsButton" Content="監視詳細" Padding="14,7" Margin="0,0,8,0"
                        Click="DetailsButton_Click" IsEnabled="False"/>
                <Button x:Name="OpenPageButton" Content="DLsiteページ" Padding="14,7" Margin="0,0,8,0"
                        Click="OpenPageButton_Click" IsEnabled="False"/>
                <Button Content="閉じる" Padding="14,7" Click="CloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
